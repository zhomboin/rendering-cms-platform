# Rendering CMS Platform 自动部署配置
#
# 安装位置：/etc/rendering-cms/deploy.env（由 deploy/setup.sh 安装）
# 所有变量均可省略，省略时使用 deploy/auto-deploy.sh 内置默认值。
# 修改后无需重启 timer，下一次触发自动生效。

# 应用代码目录（Git 仓库根目录）
# APP_DIR=/opt/rendering-cms-platform

# Git 远端与跟踪分支
# GIT_REMOTE=origin
# GIT_BRANCH=main

# 生产 Compose 文件，相对 APP_DIR 或绝对路径
# COMPOSE_FILE=deploy/docker-compose.prod.yml

# 生产环境变量文件（原 deploy/production.env，安装后统一放在 /etc/rendering-cms）
# PRODUCTION_ENV_FILE=/etc/rendering-cms/production.env

# 目录布局
# LOG_DIR=/var/log/rendering-cms
# STATE_DIR=/var/lib/rendering-cms
# BACKUP_DIR=/var/lib/rendering-cms/backups
# LOCK_DIR=/var/lock/rendering-cms

# 健康检查（PUBLIC_HTTP_BIND 变更时同步修改）
# HEALTH_URL=http://127.0.0.1:3001/api/v1/health
# HEALTH_RETRIES=12
# HEALTH_INTERVAL=5

# 数据库备份保留个数（自动 .sql.gz 与手动放入的 .sql 一起按修改时间排序，
# 超出部分在每次成功部署后清理；必须是正整数，否则回退为 14）
# BACKUP_KEEP=14

# 部署失败时是否自动回滚代码到上一成功提交
# AUTO_ROLLBACK=true

# 部署成功后是否清理 dangling 镜像
# PRUNE_IMAGES=true

# 可选：失败/成功通知 webhook（接收 JSON {"text": "..."}，如 Slack/飞书/自建网关），
# 留空表示不通知。
# NOTIFY_WEBHOOK=https://example.com/webhook
